GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# free tier: space calls out, e.g. 6 seconds for a 10 RPM limit
GEMINI_MIN_INTERVAL_SECONDS=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
RETRIEVER=dense
TOP_K=5
EMBED_DEVICE=cpu
EMBED_MODEL_NAME=jinaai/jina-embeddings-v5-text-nano-retrieval
# set false to watch the browser fill the portal (demo)
PORTAL_HEADLESS=true
PORTAL_SLOW_MO_MS=0
LOG_LEVEL=INFO
# everything else has sensible defaults in pipeline/config.py
