# Mock servers
MAIL_BASE_URL=http://127.0.0.1:8025
PORTAL_BASE_URL=http://127.0.0.1:8080

# Email addresses
PIPELINE_ADDRESS=pipeline@securitypal.test
CLIENT_ADDRESS=vendor-assessments@acme-client.test
PORTAL_ACCESS_ADDRESS=access@portal.acme-client.test
PORTAL_USERNAME=securitypal

# Gemini (Excel schema inference)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Set to 6 for free-tier 10 RPM pacing, 0 if you have a paid key
GEMINI_MIN_INTERVAL_SECONDS=0

# Ollama (RAG answer generation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Increase if the model is slow to respond on your hardware
OLLAMA_TIMEOUT_SECONDS=180

# Retrieval 
# dense, bm25, or hybrid
RETRIEVER=dense
# RRF weight split for hybrid (BM25 weight = 1 - DENSE_WEIGHT)
DENSE_WEIGHT=0.7
# Number of KB chunks fed to the LLM per question
TOP_K=5
# cpu or cuda
EMBED_DEVICE=cpu
EMBED_MODEL_NAME=jinaai/jina-embeddings-v5-text-nano-retrieval # the retrival only supports this model, donot change

# Paths (relative to repo root)
KB_PATH=data/knowledge_base/ClientABC _ ATB Financial_Knowledge Base.xlsx
QDRANT_PATH=cache/qdrant
OUTPUT_DIR=outputs

# Portal browser 
# false to watch the browser during demos
PORTAL_HEADLESS=true
# Delay in ms per browser action (visual debugging) 500 is good enough
PORTAL_SLOW_MO_MS=0

# Pipeline 
# Seconds between inbox polls
POLL_INTERVAL_SECONDS=3
# INFO for normal use, DEBUG for per-question logs and empty polls
LOG_LEVEL=INFO
